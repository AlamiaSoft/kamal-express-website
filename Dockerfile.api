FROM composer/composer:2-bin AS composer_bin

FROM serversideup/php:8.3-cli AS composer_build
WORKDIR /app
COPY --from=composer_bin /composer /usr/local/bin/composer
COPY api/composer.json ./
RUN composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader --ignore-platform-reqs

FROM serversideup/php:8.3-cli

WORKDIR /app

# Copy API codebase and installed vendor directory
COPY api/ ./
COPY --from=composer_build /app/vendor ./vendor

EXPOSE 8000
CMD ["php", "-S", "0.0.0.0:8000", "index.php"]
