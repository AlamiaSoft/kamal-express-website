{
  "name": "kamal-express/api",
  "description": "Slim API backend with Eloquent ORM for Kamal Express",
  "require": {
    "php": "^8.3",
    "slim/slim": "^4.12",
    "slim/psr7": "^1.6",
    "illuminate/database": "^11.0",
    "phpmailer/phpmailer": "^6.9"
  },
  "config": {
    "platform": {
      "php": "8.3.35"
    },
    "platform-check": false
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  }
}
